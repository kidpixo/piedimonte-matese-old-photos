{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kidpixo.github.io/piedimonte-matese-old-photos/raw_data/schema.json",
  "title": "raw_data frontmatter schema",
  "description": "Schema for raw_data/*.md YAML frontmatter. Owned by ADR-008 (schema definition) and ADR-009 (provenance fields). Update together with those ADRs.",
  "type": "object",
  "properties": {
    "layout": { "const": "photo" },
    "title": { "type": "string", "minLength": 1 },
    "date": {
      "description": "Full date, or year/year-month for approximate dating. YAML parses unquoted dates to datetime.date at load time; the validator accepts both forms.",
      "oneOf": [
        { "type": "string", "format": "date" },
        { "type": "string", "pattern": "^\\d{4}(-\\d{2})?$" },
        {
          "type": "object",
          "properties": {
            "year": { "type": "integer" },
            "month": { "type": "integer", "minimum": 1, "maximum": 12 },
            "day": { "type": "integer", "minimum": 1, "maximum": 31 }
          },
          "required": ["year"],
          "additionalProperties": false
        }
      ]
    },
    "labels": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "location": {
      "description": "Coordinate dict, or legacy list of dicts (normalized by the pipeline).",
      "oneOf": [
        { "$ref": "#/$defs/locationObj" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/locationObj" }
        }
      ]
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "is_primary": { "type": "boolean" },
          "type": { "type": "string" },
          "note": { "type": "string" },
          "alt": { "type": "string" }
        },
        "required": ["file"],
        "additionalProperties": false
      }
    },
    "primary_image": {
      "type": "string",
      "minLength": 1,
      "description": "Legacy schema: single primary image; use 'images' for new entries."
    },
    "variants": {
      "type": "array",
      "description": "Legacy schema: variants of primary_image.",
      "items": {
        "type": "object",
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "type": { "type": "string" },
          "note": { "type": "string" },
          "alt": { "type": "string" },
          "is_primary": { "type": "boolean" }
        },
        "required": ["file"],
        "additionalProperties": false
      }
    },
    "map": {
      "type": "object",
      "properties": {
        "zoom": { "type": "integer", "minimum": 0, "maximum": 22 },
        "center_lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "center_lng": { "type": "number", "minimum": -180, "maximum": 180 },
        "map_width": { "type": "string" },
        "map_height": { "type": "string" },
        "activelayers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "locate_control": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "original_url": {
      "description": "Source URL of the photo, or null if unknown.",
      "oneOf": [
        { "type": "string", "format": "uri" },
        { "type": "null" }
      ]
    },
    "supplier": { "type": "string" },
    "source": {
      "description": "ADR-009 provenance: documentary/cartographic/bibliographic/oral source. Free text or {type, ref}.",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["documentary", "cartographic", "bibliographic", "oral", "web"]
            },
            "ref": { "type": "string", "minLength": 1 }
          },
          "required": ["type", "ref"],
          "additionalProperties": false
        }
      ]
    },
    "dating": {
      "description": "ADR-009 provenance: epistemic status of the date/location. Uncertainty is recorded, never faked.",
      "enum": ["documented", "estimated", "hypothetical"]
    },
    "precision": {
      "description": "ADR-009 provenance: uncertainty note on date/location, e.g. '±5 anni'.",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": ["title", "date", "location", "labels"],
  "$defs": {
    "locationObj": {
      "type": "object",
      "properties": {
        "latitude_origin": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude_origin": { "type": "number", "minimum": -180, "maximum": 180 },
        "latitude_vertex_left": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude_vertex_left": { "type": "number", "minimum": -180, "maximum": 180 },
        "latitude_vertex_right": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude_vertex_right": { "type": "number", "minimum": -180, "maximum": 180 }
      },
      "required": ["latitude_origin", "longitude_origin"],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "not": { "required": ["images"] } },
      "then": { "required": ["primary_image"] },
      "description": "Legacy entries must provide primary_image when images is absent."
    }
  ]
}
